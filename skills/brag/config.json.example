{
  "version": 1,
  "last_updated": "2026-05-12",
  "defaults": {
    "mode": "narrative",
    "time_range": "last_week",
    "short": false,
    "slack_target": null
  },
  "sources": {
    "github": {
      "enabled": true,
      "user": "<your-github-handle>"
    },
    "git": {
      "enabled": true,
      "author": "<Your Name as in git config user.name>"
    },
    "claude_sessions": {
      "enabled": true,
      "history_path": "~/.claude/history.jsonl"
    },
    "asana": {
      "enabled": false,
      "workspace_gid": null
    },
    "slack": {
      "enabled": false,
      "user_id": null,
      "default_channel": null
    },
    "sentry": {
      "enabled": false,
      "org_slug": null,
      "project_slug": null
    }
  }
}
